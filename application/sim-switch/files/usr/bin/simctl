#!/bin/sh
# SIM slot control for Siflower CPE1252S.
# Reproduces the vendor "i2c" switch sequence from libsiminfo.lua,
# but WITHOUT the vendor [LOCK] that forced slot 1.
#
# GPIO map (from the stock firmware /etc/config/system):
#   usim1        = 139
#   esim1        = 141
#   esim2        = 138
#   active_pos2  = 140
#   disable_usim = 142
#
# Slot semantics (vendor original):
#   pos 1 -> USIM   (physical slot 1)
#   pos 2 -> ESIM1  (slot 2)
#   pos 3 -> ESIM2  (shares slot 2 with USIM on CPE1252S)
#
# Usage:
#   simctl status          -> print current slot number
#   simctl switch <1|2|3>  -> select slot
#   simctl gpio            -> dump raw gpio values

GPIO_USIM1=139
GPIO_ESIM1=141
GPIO_ESIM2=138
GPIO_ACTIVE_POS2=140
GPIO_DISABLE_USIM=142
GPIO_LIST="$GPIO_USIM1 $GPIO_ESIM1 $GPIO_ESIM2 $GPIO_ACTIVE_POS2 $GPIO_DISABLE_USIM"

CONFIG=/etc/config/sim_switch
STATE=/var/state/sim_switch

gpio_export() {
	local pin="$1"
	[ -d "/sys/class/gpio/gpio${pin}" ] || echo "$pin" > /sys/class/gpio/export 2>/dev/null
	if [ ! -e "/sys/class/gpio/gpio${pin}/direction" ]; then
		return 1
	fi
	[ "$(cat "/sys/class/gpio/gpio${pin}/direction" 2>/dev/null)" = "out" ] || \
		echo out > "/sys/class/gpio/gpio${pin}/direction" 2>/dev/null
	return 0
}

gpio_set() {
	local pin="$1" val="$2"
	gpio_export "$pin" || return 1
	echo "$val" > "/sys/class/gpio/gpio${pin}/value" 2>/dev/null
}

gpio_get() {
	local pin="$1"
	[ -e "/sys/class/gpio/gpio${pin}/value" ] || gpio_export "$pin" || { echo 0; return; }
	cat "/sys/class/gpio/gpio${pin}/value" 2>/dev/null
}

all_low() {
	local p
	for p in $GPIO_LIST; do
		gpio_set "$p" 0
	done
}

# The vendor i2c scheme routes pos1 to modem slot 2 and pos3 to modem slot 2
# as well (ESIM2 shares the slot with USIM on this board). Keep that mapping.
switch_slot() {
	local pos="$1" modem_slot=1
	case "$pos" in
		1)
			all_low
			gpio_set "$GPIO_USIM1" 1
			sleep 1
			gpio_set "$GPIO_ACTIVE_POS2" 1
			modem_slot=2
			;;
		2)
			all_low
			modem_slot=1
			;;
		3)
			all_low
			gpio_set "$GPIO_DISABLE_USIM" 1
			gpio_set "$GPIO_ESIM2" 1
			sleep 1
			gpio_set "$GPIO_ACTIVE_POS2" 1
			modem_slot=2
			;;
		*)
			echo "invalid slot: $pos" >&2
			return 1
			;;
	esac

	# Tell the modem which virtual slot is active (best effort).
	ubus -t 2 call qmodem set_sim_slot "{\"slot\":$modem_slot}" >/dev/null 2>&1
	ubus -t 2 call telephony.multiSim set_switch_sim "{\"pos\":$modem_slot}" >/dev/null 2>&1

	mkdir -p "$(dirname "$STATE")"
	echo "$pos" > "$STATE"
	uci -q set sim_switch.main.active_slot="$pos"
	uci -q commit sim_switch
	echo "switched to slot $pos (modem slot $modem_slot)"
	return 0
}

status() {
	local saved=""
	[ -f "$STATE" ] && saved=$(cat "$STATE" 2>/dev/null)
	[ -z "$saved" ] && saved=$(uci -q get sim_switch.main.active_slot 2>/dev/null)
	[ -z "$saved" ] && saved=2
	echo "$saved"
}

case "$1" in
	status) status ;;
	switch) switch_slot "$2" ;;
	gpio)
		for p in $GPIO_LIST; do
			echo "gpio${p}=$(gpio_get "$p")"
		done
		;;
	*)
		echo "usage: $0 {status|switch <1|2|3>|gpio}" >&2
		exit 1
		;;
esac
